@startuml
skinparam ArrowFontSize 20
skinparam ParticipantFontSize 20
skinparam Shadowing false
hide footbox
participant ":LogicManager" as logic
participant ":Model" as model
participant ":Storage" as storage

[-> logic : execute("undo")
activate logic
logic -> logic : Parse UndoCommand;\nexecuteUndo()
logic -> model : getAddressBook()
activate model
model --> logic : currentState
deactivate model
logic -> logic : current = new\nAddressBook(currentState)
logic -> model : setAddressBook(\nundoStack.peek())
activate model
model --> logic
deactivate model
logic -> storage : saveAddressBook(\nrestoredState)
activate storage
storage --> logic : Saved
deactivate storage
logic -> logic : undoStack.pop()\nredoStack.push(current)
logic -> model : updateFilteredPersonList(\nPREDICATE_SHOW_ALL_PERSONS)
activate model
model --> logic
deactivate model
[<-- logic : Success
deactivate logic
@enduml
