@startuml
skinparam ArrowFontSize 20
skinparam ParticipantFontSize 20
skinparam Shadowing false
hide footbox
participant ":LogicManager" as logic
participant "undo:UndoCommand" as command
participant ":Model" as model
participant ":Storage" as storage

[-> logic : execute("undo")
activate logic
logic -> logic : Parse request; supply\nundoStates.peek()
logic -> model : getAddressBook()
activate model
model --> logic : currentState
deactivate model
logic -> logic : backup = new\nAddressBook(currentState)
logic -> command : execute(model)
activate command
command -> model : setAddressBook(\nprevious)
activate model
model --> command
deactivate model
command --> logic : CommandResult
deactivate command
logic -> storage : saveAddressBook(\nrestoredState)
activate storage
storage --> logic : Saved
deactivate storage
logic -> logic : undoStates.pop()\nredoStates.push(backup)
[<-- logic : Success
deactivate logic
@enduml
