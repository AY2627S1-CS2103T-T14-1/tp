@startuml
skinparam ArrowFontSize 20
skinparam NoteFontSize 20
skinparam ParticipantFontSize 20
skinparam Shadowing false
hide footbox
participant ":LogicManager" as logic
participant "undo:UndoCommand" as command
participant ":Model" as model
participant ":Storage" as storage

[-> logic : execute("undo")
activate logic
note over logic, model : backup contains the\ncurrent address book
logic -> command : execute(model)
activate command
command -> model : setAddressBook(\nprevious)
activate model
model --> command
deactivate model
command --> logic : CommandResult
deactivate command
logic -> storage : saveAddressBook(\nrestoredState)
activate storage
storage --> logic : throws IOException
deactivate storage
logic -> model : setAddressBook(\nbackup)
activate model
model --> logic
deactivate model
note over logic : Both history stacks\nremain unchanged
[<-- logic : throws CommandException
deactivate logic
@enduml
