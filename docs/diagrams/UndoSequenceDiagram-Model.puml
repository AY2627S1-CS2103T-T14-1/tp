@startuml
skinparam ArrowFontSize 20
skinparam ParticipantFontSize 20
skinparam NoteFontSize 20
skinparam Shadowing false
hide footbox
participant ":LogicManager" as logic
participant ":Model" as model
participant ":Storage" as storage

[-> logic : execute("undo")
activate logic
note over logic, model : current contains the\npre-undo address book
logic -> model : setAddressBook(\nundoStack.peek())
activate model
model --> logic
deactivate model
logic -> storage : saveAddressBook(\nrestoredState)
activate storage
storage --> logic : throws IOException
deactivate storage
logic -> model : setAddressBook(\ncurrent)
activate model
model --> logic
deactivate model
note over logic : Both history stacks\nand the filter are unchanged
[<-- logic : throws CommandException
deactivate logic
@enduml
