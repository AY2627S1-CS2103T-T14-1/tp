@startuml
' Exported with PlantUML 1.2025.10; the shared project style is unchanged.
!pragma layout smetana
!include style.puml
skinparam arrowThickness 1.1
skinparam arrowColor STORAGE_COLOR
skinparam classBackgroundColor STORAGE_COLOR
skinparam nodesep 30
skinparam ranksep 45
scale 2
left to right direction

' Scope: retained client-adapter references and nested conversion helpers.
' Multiplicities describe supported, validated data rather than malformed JSON.
package "Storage: client JSON adapters" {
    class JsonAdaptedPerson
    class JsonAdaptedTag
    class JsonAdaptedExercise
    class JsonAdaptedDietPlan
    class JsonAdaptedTrainingSession
    class JsonAdaptedWorkoutSession
    class JsonAdaptedWorkoutLogEntry
    class JsonAdaptedMembershipAssignment
    class JsonAdaptedPaymentRecord
    class JsonAdaptedBodyProgress
    class JsonAdaptedBodyBaseline
    class JsonAdaptedBodyProgressEntry
}

JsonAdaptedPerson --> "0..1" JsonAdaptedBodyProgress
JsonAdaptedPerson --> "0..1" JsonAdaptedMembershipAssignment
JsonAdaptedPerson --> "0..*" JsonAdaptedPaymentRecord
JsonAdaptedPerson --> "0..*" JsonAdaptedWorkoutSession
JsonAdaptedPerson --> "0..*" JsonAdaptedTrainingSession
JsonAdaptedPerson --> "0..1" JsonAdaptedDietPlan
JsonAdaptedPerson --> "0..*" JsonAdaptedExercise
JsonAdaptedPerson --> "0..*" JsonAdaptedTag
JsonAdaptedWorkoutSession --> "1..30" JsonAdaptedWorkoutLogEntry
JsonAdaptedBodyProgress ..> JsonAdaptedBodyBaseline
JsonAdaptedBodyProgress ..> JsonAdaptedBodyProgressEntry

legend bottom left
    Solid arrow: association with navigability
    Dashed arrow: dependency
    Multiplicities describe validated data.
    Membership assignments store a plan key, not a plan-adapter reference.
    Body-progress adapters retain raw JsonNode data;
    baseline/entry adapters are temporary conversion helpers.
    Primitive/string fields, JSON tree classes and model classes are omitted.
endlegend
@enduml
