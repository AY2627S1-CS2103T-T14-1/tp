<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="8" minHeight="180" prefHeight="240" maxHeight="280" styleClass="card"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
  <padding>
    <Insets top="12" right="14" bottom="12" left="14" />
  </padding>
  <Label text="Body progress" styleClass="section-title" />
  <ScrollPane fx:id="bodyScroll" fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS"
              styleClass="workout-scroll">
    <VBox fx:id="bodyContent" spacing="10" minWidth="0">
      <Label fx:id="baseline" styleClass="profile-value" wrapText="true" minHeight="-Infinity" />
      <Label fx:id="historyHeading" styleClass="caps-label" />
      <VBox fx:id="historyRows" spacing="8" minWidth="0" />
      <Label fx:id="comparisonHeading" text="Latest comparison" styleClass="caps-label" />
      <Label fx:id="comparison" styleClass="profile-value" wrapText="true" minHeight="-Infinity" />
    </VBox>
  </ScrollPane>
</VBox>
