<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<GridPane styleClass="client-cell" hgap="12" xmlns="http://javafx.com/javafx/17"
          xmlns:fx="http://javafx.com/fxml/1">
  <columnConstraints>
    <ColumnConstraints minWidth="32" prefWidth="32" maxWidth="32" />
    <ColumnConstraints hgrow="ALWAYS" minWidth="0" />
  </columnConstraints>
  <padding>
    <Insets top="12" right="10" bottom="12" left="10" />
  </padding>
  <Label fx:id="id" alignment="CENTER" minWidth="32" minHeight="32" prefWidth="32" prefHeight="32"
         styleClass="index-badge" GridPane.columnIndex="0" GridPane.valignment="TOP" />
  <VBox spacing="5" minWidth="0" GridPane.columnIndex="1">
    <Label fx:id="name" maxWidth="Infinity" styleClass="client-name" />
    <Label fx:id="phone" styleClass="client-phone,mono" />
    <FlowPane fx:id="tags" hgap="4" vgap="4" minWidth="0" />
    <Label fx:id="meta" maxWidth="Infinity" styleClass="client-meta" wrapText="true" />
  </VBox>
</GridPane>
