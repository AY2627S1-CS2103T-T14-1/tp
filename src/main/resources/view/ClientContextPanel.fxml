<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
  <VBox fx:id="selectedContent" spacing="16" minWidth="0">
    <VBox spacing="14" styleClass="card,context-card">
      <FlowPane hgap="10" vgap="5" styleClass="context-heading">
        <Label text="" minWidth="10" minHeight="10" maxWidth="10" maxHeight="10" styleClass="diet-marker" />
        <Label text="DIET" styleClass="caps-label,diet-label" />
        <Label text="Targets &amp; notes" wrapText="true" styleClass="context-title" />
      </FlowPane>
      <VBox fx:id="dietContent" spacing="12">
        <VBox spacing="5">
          <Label text="TARGET" styleClass="caps-label" />
          <Label fx:id="dietTarget" wrapText="true" minWidth="0" maxWidth="Infinity"
                 styleClass="context-body" />
        </VBox>
        <VBox fx:id="dietNotesBox" spacing="5" styleClass="diet-notes">
          <Label text="NOTES" styleClass="caps-label" />
          <Label fx:id="dietNotes" wrapText="true" styleClass="context-body" />
        </VBox>
      </VBox>
      <VBox fx:id="dietaryRestrictionsBox" spacing="5" styleClass="diet-notes" visible="false" managed="false">
        <Label text="DIETARY RESTRICTIONS" styleClass="caps-label" />
        <Label fx:id="dietaryRestrictions" wrapText="true" styleClass="context-body" />
      </VBox>
    </VBox>

    <VBox spacing="12" styleClass="card,context-card">
      <FlowPane hgap="10" vgap="5" styleClass="context-heading">
        <Label text="" minWidth="10" minHeight="10" maxWidth="10" maxHeight="10" styleClass="session-marker" />
        <Label text="SCHEDULE" styleClass="caps-label,schedule-label" />
        <Label text="Sessions" styleClass="context-title" />
      </FlowPane>
      <VBox fx:id="sessionRows" spacing="8" />
    </VBox>

    <VBox spacing="12" styleClass="card,context-card">
      <FlowPane hgap="10" vgap="5" styleClass="context-heading">
        <Label text="" alignment="CENTER" minWidth="20" minHeight="20" styleClass="history-header-icon" />
        <Label text="HISTORY" styleClass="caps-label" />
        <Label text="Completed workouts" wrapText="true" styleClass="context-title" />
      </FlowPane>
      <VBox fx:id="historyRows" />
    </VBox>
    <StackPane fx:id="bodyProgressPlaceholder" />
    <VBox spacing="12" styleClass="card,payments-card" VBox.vgrow="ALWAYS">
      <FlowPane hgap="10" vgap="5" styleClass="context-heading">
        <Region minWidth="10" minHeight="10" maxWidth="10" maxHeight="10" styleClass="payment-marker" />
        <Label text="PAYMENTS" styleClass="caps-label" />
        <Label text="Billing" styleClass="context-title" />
      </FlowPane>
      <VBox fx:id="paymentRows" spacing="0" minWidth="0" />
      <Label fx:id="paymentEmpty" text="No payments recorded." styleClass="muted" />
    </VBox>
  </VBox>
  <Region fx:id="emptyContent" />
</StackPane>
